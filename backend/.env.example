# Configuration environnement local
DATABASE_URL=sqlite:///./trading_journal.db
UPLOAD_DIR=uploads
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5500

# Authentification
OWNER_PASSWORD_HASH=your_local_password_hash_here
JWT_SECRET=your_local_jwt_secret_here

# ============================================
# PRODUCTION - Render + Supabase
# ============================================

# Base de données PostgreSQL (Supabase)
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Supabase Storage (pour les images)
# SUPABASE_URL=https://[REF].supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Service Role Key
# SUPABASE_BUCKET=trade-images

# URLs
# BASE_URL=https://votre-app.onrender.com
# FRONTEND_URL=https://votre-app.netlify.app

# Authentification (production)
# OWNER_PASSWORD_HASH=your_production_password_hash_here
# JWT_SECRET=your_production_jwt_secret_here